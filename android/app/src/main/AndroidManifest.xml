<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the Steam download, the import, moving storage and mod downloads go on in the background
         (JobService, QueueService), with their progress in a notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Updates from the GitHub releases (Updater.java), the mod catalog and achievements -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the game back in front on the top screen after Pixel Guide opens on the bottom one -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Game files > Storage > Use your own folder: the files in a folder the player picks, such as
         /sdcard/FF9Recomp. Asked for only when they choose one (Storage.java). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Pixel Guide: the bottom screen's book opens it when it is installed (CompanionView) -->
    <queries>
        <package android:name="app.nanostack.pixelguide" />
    </queries>
    <application
        android:label="FF9Recomp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask" android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <activity android:name=".CompanionHostActivity" android:exported="false" android:process=":game"
            android:excludeFromRecents="true" android:taskAffinity="com.ff9recomp.panels"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <activity android:name=".TouchLayoutActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <service android:name=".JobService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".QueueService" android:exported="false" android:foregroundServiceType="dataSync" />
        <receiver android:name=".Updater$InstallResult" android:exported="false" />
        <!-- Pixel Guide's installer answer (GuideInstaller), in the game's process -->
        <receiver android:name=".GuideInstaller$Result" android:exported="false" android:process=":game" />
        <!-- Pixel Guide's install confirmation on the bottom screen (GuideInstaller): in a process
             of its own, telling the game's process through Events -->
        <receiver android:name=".GuideHostActivity$Events" android:exported="false" android:process=":game" />
        <activity android:name=".GuideHostActivity" android:exported="false" android:process=":guide"
            android:taskAffinity=".guide" android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode" />
        <!-- adb test API (TestControl): GET/SET/STOP/REPORT/STEAM_DOWNLOAD. DUMP: only the shell may call it -->
        <receiver android:name=".TestControl" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.ff9recomp.test.GET" />
                <action android:name="com.ff9recomp.test.SET" />
                <action android:name="com.ff9recomp.test.STOP" />
                <action android:name="com.ff9recomp.test.REPORT" />
                <action android:name="com.ff9recomp.test.STEAM_DOWNLOAD" />
                <action android:name="com.ff9recomp.test.STEAM_CLOUD" />
                <action android:name="com.ff9recomp.test.SCREEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
